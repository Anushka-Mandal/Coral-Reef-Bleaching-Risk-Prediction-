# Copy to .env and fill in. .env is ignored by git - never commit your key.
# Free: leave this empty and run `ollama serve` (model qwen2.5:3b). Paid: add a Claude key.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional
# CORALWATCH_LLM=local            # local | claude | offline (default: auto)
# CORALWATCH_LOCAL_MODEL=qwen2.5:3b
# CORALWATCH_MODEL=claude-opus-5
# CORALWATCH_PORT=8000
